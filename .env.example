# Mattermost or Slack incoming webhook.
# Leave empty to skip the webhook.
WEBHOOK_URL=

# Telegram bot from @BotFather. Both values are required to send a Telegram message.
# Find TELEGRAM_CHAT_ID with: python notifier.py --chat-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Personal Indico token created while logged in with your CERN account.
# Leave empty to send only the public seminar list.
# Scopes: User information (read only), Everything (only GET), Classic API (read only).
INDICO_API_TOKEN=
